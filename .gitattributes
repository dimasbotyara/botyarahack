# Единый стиль переводов строк: в репозитории — LF.
#
# Атрибут "text" (без eol=...) означает: Git нормализует файл в LF при коммите,
# а при checkout конвертирует обратно в CRLF ТОЛЬКО если у тебя включён
# core.autocrlf=true (обычное поведение Git for Windows).
# На Linux/macOS файлы остаются с LF. Так один репозиторий работает везде.
* text=auto

# Исходники и тексты — точно текстовые (нормализуются в LF в репозитории)
*.py       text
*.pyw      text
*.txt      text
*.md       text
*.json     text
*.yml      text
*.yaml     text
*.toml     text
*.ini      text
*.cfg      text
*.bat      text
*.cmd      text

# Скрипты всегда с LF (иначе ломается shebang)
*.sh       text eol=lf

# Бинарные файлы — без автоконвертации
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.bmp      binary
*.wav      binary
*.mp3      binary
*.ogg      binary
*.ttf      binary
*.otf      binary
*.zip      binary
*.exe      binary
*.dll      binary
